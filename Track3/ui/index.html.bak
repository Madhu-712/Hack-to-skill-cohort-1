<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TaxCo — AI Tax Compliance Agent</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=JetBrains+Mono:wght@300;400;500&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #f5f0e8;
  --bg2: #ede8dc;
  --surface: #ffffff;
  --surface2: #faf8f4;
  --border: #d9d0bc;
  --border2: #c4b99a;
  --ink: #1a1410;
  --ink2: #4a4035;
  --ink3: #8a7a65;
  --accent: #b5462a;
  --accent2: #d4622e;
  --accent-bg: rgba(181,70,42,0.08);
  --green: #2a6b3c;
  --green-bg: rgba(42,107,60,0.08);
  --amber: #b5820a;
  --amber-bg: rgba(181,130,10,0.08);
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  background: var(--bg);
  color: var(--ink);
  font-family: 'Outfit', sans-serif;
  font-weight: 300;
  min-height: 100vh;
  background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23c4b99a' fill-opacity='0.15'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
}
.app { max-width: 1000px; margin: 0 auto; padding: 40px 24px 80px; }
.header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 48px; padding-bottom: 24px; border-bottom: 2px solid var(--ink);
}
.logo { font-family: 'Playfair Display', serif; font-size: 2.4rem; font-weight: 700; letter-spacing: -1px; line-height: 1; }
.logo em { color: var(--accent); font-style: italic; }
.logo-sub { font-family: 'JetBrains Mono', monospace; font-size: 0.65rem; letter-spacing: 0.2em; color: var(--ink3); text-transform: uppercase; margin-top: 4px; }
.header-right { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
.live-badge { display: flex; align-items: center; gap: 6px; font-family: 'JetBrains Mono', monospace; font-size: 0.65rem; letter-spacing: 0.1em; color: var(--green); background: var(--green-bg); border: 1px solid var(--green); border-radius: 4px; padding: 4px 10px; }
.live-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green); animation: blink 1.5s ease-in-out infinite; }
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.2} }
.endpoint-tag { font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; color: var(--ink3); }
.layout { display: grid; grid-template-columns: 1fr 320px; gap: 24px; align-items: start; }
.card { background: var(--surface); border: 1px solid var(--border); border-radius: 4px; margin-bottom: 20px; overflow: hidden; box-shadow: 3px 3px 0 var(--border2); }
.card-header { display: flex; align-items: center; justify-content: space-between; padding: 12px 18px; background: var(--ink); color: var(--bg); }
.card-title { font-family: 'JetBrains Mono', monospace; font-size: 0.68rem; letter-spacing: 0.15em; text-transform: uppercase; }
.card-body { padding: 20px; }
.query-textarea { width: 100%; background: var(--surface2); border: 1px solid var(--border); border-radius: 4px; padding: 14px; color: var(--ink); font-family: 'Outfit', sans-serif; font-size: 0.95rem; font-weight: 300; resize: none; outline: none; line-height: 1.6; min-height: 90px; transition: border-color 0.2s; }
.query-textarea:focus { border-color: var(--accent); }
.query-textarea::placeholder { color: var(--ink3); }
.btn-row { display: flex; gap: 8px; margin-top: 12px; }
.btn-primary { flex: 1; background: var(--accent); color: white; border: none; border-radius: 4px; padding: 12px 20px; font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; letter-spacing: 0.08em; font-weight: 500; cursor: pointer; transition: all 0.15s; text-transform: uppercase; }
.btn-primary:hover:not(:disabled) { background: var(--accent2); transform: translateY(-1px); box-shadow: 0 4px 12px rgba(181,70,42,0.3); }
.btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
.btn-clear { background: transparent; color: var(--ink3); border: 1px solid var(--border); border-radius: 4px; padding: 12px 16px; font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; cursor: pointer; transition: all 0.15s; }
.btn-clear:hover { border-color: var(--ink3); color: var(--ink); }
.presets-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 4px; }
.preset-chip { background: var(--surface2); border: 1px solid var(--border); border-radius: 4px; padding: 10px 12px; cursor: pointer; transition: all 0.15s; }
.preset-chip:hover { border-color: var(--accent); background: var(--accent-bg); }
.preset-name { font-size: 0.8rem; font-weight: 500; color: var(--ink); margin-bottom: 2px; }
.preset-desc { font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; color: var(--ink3); letter-spacing: 0.04em; }
.trace-list { display: flex; flex-direction: column; gap: 6px; }
.trace-item { display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-left: 3px solid var(--border2); background: var(--surface2); border-radius: 0 4px 4px 0; font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; color: var(--ink3); animation: slideIn 0.25s ease; }
.trace-item.active { border-left-color: var(--accent); color: var(--accent); background: var(--accent-bg); }
.trace-item.done { border-left-color: var(--green); color: var(--green); }
.trace-item.error { border-left-color: var(--accent); color: var(--accent); }
@keyframes slideIn { from{opacity:0;transform:translateX(-6px)} to{opacity:1;transform:translateX(0)} }
.trace-params { margin-left: auto; font-size: 0.6rem; color: var(--ink3); max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; opacity: 0.7; }
.spinner { display: inline-block; width: 10px; height: 10px; border: 2px solid var(--border); border-top-color: var(--accent); border-radius: 50%; animation: spin 0.6s linear infinite; }
@keyframes spin { to{transform:rotate(360deg)} }
.response-content { line-height: 1.75; font-size: 0.92rem; color: var(--ink2); }
.response-content strong { color: var(--accent); font-weight: 600; }
.response-content em { color: var(--amber); font-style: normal; font-weight: 500; }
.response-content code { font-family: 'JetBrains Mono', monospace; font-size: 0.82em; background: var(--surface2); padding: 2px 6px; border-radius: 3px; border: 1px solid var(--border); color: var(--accent); }
.data-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin: 16px 0; }
.data-card { background: var(--surface2); border: 1px solid var(--border); border-radius: 4px; padding: 14px; }
.data-card-label { font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; letter-spacing: 0.12em; color: var(--ink3); text-transform: uppercase; margin-bottom: 6px; }
.data-card-value { font-family: 'Playfair Display', serif; font-size: 1.4rem; color: var(--ink); }
.data-card-value.red { color: var(--accent); }
.data-card-value.green { color: var(--green); }
.data-card-value.amber { color: var(--amber); }
.updated-badge { margin-top: 14px; padding: 10px 14px; background: var(--green-bg); border: 1px solid var(--green); border-radius: 4px; font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; color: var(--green); }
hr.divider { border: none; border-top: 1px solid var(--border); margin: 16px 0; }
.clients-list { display: flex; flex-direction: column; gap: 6px; }
.client-item { display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; background: var(--surface2); border: 1px solid var(--border); border-radius: 4px; cursor: pointer; transition: all 0.15s; }
.client-item:hover { border-color: var(--accent); background: var(--accent-bg); }
.client-name { font-size: 0.85rem; font-weight: 500; }
.client-id { font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; color: var(--ink3); background: var(--bg2); padding: 2px 6px; border-radius: 3px; }
.history-item { padding: 10px 14px; border-left: 2px solid var(--border2); cursor: pointer; transition: all 0.15s; opacity: 0.7; margin-bottom: 6px; }
.history-item:hover { border-left-color: var(--accent); opacity: 1; }
.history-q { font-size: 0.8rem; color: var(--ink2); margin-bottom: 2px; }
.history-ts { font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; color: var(--ink3); }
.empty-state { text-align: center; padding: 24px 16px; color: var(--ink3); font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; }
.api-warning { background: var(--amber-bg); border: 1px solid var(--amber); border-radius: 4px; padding: 10px 14px; font-family: 'JetBrains Mono', monospace; font-size: 0.68rem; color: var(--amber); margin-bottom: 12px; display: none; }
.api-warning.show { display: block; }
.section-micro { font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; letter-spacing: 0.15em; color: var(--ink3); text-transform: uppercase; margin-bottom: 8px; }
@media (max-width: 720px) { .layout { grid-template-columns: 1fr; } .presets-grid { grid-template-columns: 1fr; } }
</style>
</head>
<body>
<div class="app">
  <div class="header">
    <div>
      <div class="logo">Tax<em>Co</em></div>
      <div class="logo-sub">AI Tax Compliance Agent · India FY 2024–25</div>
    </div>
    <div class="header-right">
      <div class="live-badge"><div class="live-dot"></div>ALLOYDB · LIVE</div>
      <div class="endpoint-tag">taxco-agent-ui · us-central1.run.app</div>
    </div>
  </div>

  <div class="layout">
    <div class="left-panel">

      <!-- Config -->
      <div class="card">
        <div class="card-header">
          <span class="card-title">⚙ Configuration</span>
        </div>
        <div class="card-body">
          <div class="api-warning" id="api-warning">⚠ Enter your Anthropic API key to enable the agent</div>
          <div style="display:flex;gap:10px;align-items:flex-end">
            <div style="flex:1">
              <div class="section-micro">Anthropic API Key</div>
              <input type="password" id="api-key" placeholder="sk-ant-..."
                style="width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:4px;padding:8px 12px;color:var(--ink);font-family:'JetBrains Mono',monospace;font-size:0.8rem;outline:none;transition:border-color 0.2s"
                onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border)'" />
            </div>
            <button onclick="saveKey()" style="background:var(--ink);color:var(--bg);border:none;border-radius:4px;padding:9px 16px;font-family:'JetBrains Mono',monospace;font-size:0.7rem;cursor:pointer;letter-spacing:0.06em">SAVE</button>
          </div>
          <div style="margin-top:10px;font-family:'JetBrains Mono',monospace;font-size:0.6rem;color:var(--ink3)">
            Toolbox → <span style="color:var(--green)">taxco-agent-ui-408405281092.us-central1.run.app</span>
          </div>
        </div>
      </div>

      <!-- Query -->
      <div class="card">
        <div class="card-header">
          <span class="card-title">◈ Agent Query</span>
          <span style="font-family:'JetBrains Mono',monospace;font-size:0.6rem;color:var(--bg2)">Ctrl+Enter to run</span>
        </div>
        <div class="card-body">
          <textarea class="query-textarea" id="query-input"
            placeholder="e.g. Calculate tax liability for Zara Khan and update the records…"
            rows="3" onkeydown="handleKey(event)"></textarea>
          <div class="btn-row">
            <button class="btn-primary" id="run-btn" onclick="runAgent()">▶ RUN AGENT</button>
            <button class="btn-clear" onclick="clearAll()">CLEAR</button>
          </div>
          <div style="margin-top:16px">
            <div class="section-micro">Quick Queries</div>
            <div class="presets-grid">
              <div class="preset-chip" onclick="setQuery('Calculate tax liability for Zara Khan and update records')">
                <div class="preset-name">Zara Khan</div>
                <div class="preset-desc">Full tax calc + update</div>
              </div>
              <div class="preset-chip" onclick="setQuery('What is the financial profile of Aarav Patel?')">
                <div class="preset-name">Aarav Patel</div>
                <div class="preset-desc">Profile lookup</div>
              </div>
              <div class="preset-chip" onclick="setQuery('Calculate taxes for Vihaan Sharma with harvesting strategy')">
                <div class="preset-name">Vihaan Sharma</div>
                <div class="preset-desc">Tax + harvesting</div>
              </div>
              <div class="preset-chip" onclick="setQuery('Find and calculate tax for Myra Joshi')">
                <div class="preset-name">Myra Joshi</div>
                <div class="preset-desc">Find + calculate</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Trace -->
      <div class="card" id="trace-card" style="display:none">
        <div class="card-header">
          <span class="card-title">⚡ Tool Execution</span>
          <span id="trace-status" style="font-family:'JetBrains Mono',monospace;font-size:0.6rem;color:var(--bg2)"></span>
        </div>
        <div class="card-body"><div class="trace-list" id="trace-list"></div></div>
      </div>

      <!-- Response -->
      <div class="card" id="response-card" style="display:none">
        <div class="card-header">
          <span class="card-title">◆ Agent Response</span>
          <span id="response-time" style="font-family:'JetBrains Mono',monospace;font-size:0.6rem;color:var(--bg2)"></span>
        </div>
        <div class="card-body" id="response-body"></div>
      </div>

    </div>

    <div class="right-panel">

      <!-- Clients -->
      <div class="card">
        <div class="card-header"><span class="card-title">👥 Clients</span></div>
        <div class="card-body" style="padding:12px">
          <div class="clients-list" id="clients-list">
            <div class="client-item" onclick="setQuery('Calculate tax for Aarav Patel and update records')"><div class="client-name">Aarav Patel</div><div class="client-id">#001</div></div>
            <div class="client-item" onclick="setQuery('Calculate tax for Zara Khan and update records')"><div class="client-name">Zara Khan</div><div class="client-id">#002</div></div>
            <div class="client-item" onclick="setQuery('Calculate tax for Vihaan Sharma and update records')"><div class="client-name">Vihaan Sharma</div><div class="client-id">#003</div></div>
            <div class="client-item" onclick="setQuery('Calculate tax for Ananya Gupta and update records')"><div class="client-name">Ananya Gupta</div><div class="client-id">#004</div></div>
            <div class="client-item" onclick="setQuery('Calculate tax for Arjun Nair and update records')"><div class="client-name">Arjun Nair</div><div class="client-id">#005</div></div>
            <div class="client-item" onclick="setQuery('Calculate tax for Saanvi Verma and update records')"><div class="client-name">Saanvi Verma</div><div class="client-id">#006</div></div>
            <div class="client-item" onclick="setQuery('Calculate tax for Ishaan Malhotra and update records')"><div class="client-name">Ishaan Malhotra</div><div class="client-id">#007</div></div>
            <div class="client-item" onclick="setQuery('Calculate tax for Kyra Iyer and update records')"><div class="client-name">Kyra Iyer</div><div class="client-id">#008</div></div>
            <div class="client-item" onclick="setQuery('Calculate tax for Reyansh Singh and update records')"><div class="client-name">Reyansh Singh</div><div class="client-id">#009</div></div>
            <div class="client-item" onclick="setQuery('Calculate tax for Myra Joshi and update records')"><div class="client-name">Myra Joshi</div><div class="client-id">#010</div></div>
          </div>
        </div>
      </div>

      <!-- Tax Rules -->
      <div class="card">
        <div class="card-header"><span class="card-title">📋 Tax Rules FY24-25</span></div>
        <div class="card-body" style="font-family:'JetBrains Mono',monospace;font-size:0.63rem;color:var(--ink3);line-height:1.9">
          <div style="color:var(--ink);font-weight:500;margin-bottom:4px">Salary Slabs (New Regime)</div>
          <div>0 – 3L &nbsp;&nbsp;&nbsp;&nbsp;→ 0%</div>
          <div>3 – 7L &nbsp;&nbsp;&nbsp;&nbsp;→ 5%</div>
          <div>7 – 10L &nbsp;&nbsp;&nbsp;→ 10%</div>
          <div>10 – 12L &nbsp;&nbsp;→ 15%</div>
          <div>12 – 15L &nbsp;&nbsp;→ 20%</div>
          <div>Above 15L &nbsp;→ 30%</div>
          <div style="border-top:1px solid var(--border);margin:8px 0"></div>
          <div style="color:var(--ink);font-weight:500;margin-bottom:4px">Capital Gains</div>
          <div>LTCG → 12.5% (above ₹1.25L)</div>
          <div>STCG → 20% flat</div>
          <div style="border-top:1px solid var(--border);margin:8px 0"></div>
          <div style="color:var(--ink);font-weight:500;margin-bottom:4px">Deductions</div>
          <div>Standard → ₹75,000</div>
        </div>
      </div>

      <!-- History -->
      <div class="card">
        <div class="card-header"><span class="card-title">🕐 Session History</span></div>
        <div class="card-body" style="padding:12px">
          <div id="history-list"><div class="empty-state">No queries yet</div></div>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
const TOOLBOX_URL = 'https://taxco-ui-408405281092.us-central1.run.app';

const MODEL = 'claude-sonnet-4-20250514';
const SYSTEM_PROMPT = `You are TaxCo, an expert Indian tax compliance agent for FY 2024-25 connected to an AlloyDB database.

TOOLS AVAILABLE:
1. find_client_by_name — semantic search by name, returns client_id, firstname, lastname
2. get_financial_profile — fetch salary, ltcg, stcg by client_id
3. update_tax_records — save tax_liability, tax_loss, tax_gain by client_id

INDIAN TAX RULES (New Regime FY 2024-25):
Salary slabs (after ₹75,000 standard deduction):
- 0 to 3L: 0%
- 3L to 7L: 5% (max ₹20,000)
- 7L to 10L: 10% (max ₹30,000)
- 10L to 12L: 15% (max ₹30,000)
- 12L to 15L: 20% (max ₹60,000)
- Above 15L: 30%

LTCG: 12.5% on gains exceeding ₹1,25,000 exemption
STCG: 20% flat

TAX HARVESTING:
- Tax Loss Harvesting: Suggest booking losses to offset gains → set tax_loss
- Tax Gain Harvesting: If LTCG < ₹1,25,000, harvest gains up to exemption → set tax_gain

WORKFLOW:
1. find_client_by_name → get client_id
2. get_financial_profile → get salary, ltcg, stcg
3. Calculate: taxable_salary = salary - 75000, apply slabs, add LTCG tax, add STCG tax
4. Determine harvesting strategy
5. update_tax_records with all values
6. Present clear breakdown with ₹ amounts in Indian number format (e.g. ₹12,50,000)`;

const TOOLS = [
  { name: "find_client_by_name", description: "Find a client's ID using semantic search on their name.", input_schema: { type: "object", properties: { name_query: { type: "string" } }, required: ["name_query"] } },
  { name: "get_financial_profile", description: "Get salary, LTCG, and STCG for a specific client ID.", input_schema: { type: "object", properties: { client_id: { type: "integer" } }, required: ["client_id"] } },
  { name: "update_tax_records", description: "Save calculated tax liability and harvesting strategy back to the database.", input_schema: { type: "object", properties: { client_id: { type: "integer" }, tax_liability: { type: "integer" }, tax_loss: { type: "integer" }, tax_gain: { type: "integer" } }, required: ["client_id", "tax_liability", "tax_loss", "tax_gain"] } }
];

let isRunning = false;
let apiKey = localStorage.getItem('taxco_key') || '';
if (apiKey) document.getElementById('api-key').value = apiKey;

function saveKey() {
  apiKey = document.getElementById('api-key').value.trim();
  localStorage.setItem('taxco_key', apiKey);
  document.getElementById('api-warning').classList.remove('show');
  const btn = event.target;
  btn.textContent = '✓ SAVED';
  setTimeout(() => btn.textContent = 'SAVE', 1500);
}

function setQuery(q) { document.getElementById('query-input').value = q; document.getElementById('query-input').focus(); }
function handleKey(e) { if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) runAgent(); }
function clearAll() {
  document.getElementById('query-input').value = '';
  document.getElementById('trace-card').style.display = 'none';
  document.getElementById('response-card').style.display = 'none';
  document.getElementById('trace-list').innerHTML = '';
}

async function callTool(name, params) {
  const res = await fetch(`${TOOLBOX_URL}/api/tool/${name}/invoke`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(params)
  });
  if (!res.ok) throw new Error(`Tool ${name} failed: HTTP ${res.status}`);
  const data = await res.json();
  if (data.error) throw new Error(data.error);
  try { return typeof data.result === 'string' ? JSON.parse(data.result) : data.result; } catch { return data.result; }
}

function addTrace(icon, label, params, state = 'active') {
  const list = document.getElementById('trace-list');
  const id = 'tr' + Date.now() + Math.random().toString(36).slice(2);
  const el = document.createElement('div');
  el.className = `trace-item ${state}`;
  el.id = id;
  el.innerHTML = `<span class="ti">${state === 'active' ? '<span class="spinner"></span>' : icon}</span><span>${label}</span><span class="trace-params">${params ? JSON.stringify(params).slice(0,50) : ''}</span>`;
  list.appendChild(el);
  return id;
}

function updateTrace(id, icon, state) {
  const el = document.getElementById(id);
  if (!el) return;
  el.className = `trace-item ${state}`;
  el.querySelector('.ti').innerHTML = icon;
}

async function runAgent() {
  if (isRunning) return;
  apiKey = document.getElementById('api-key').value.trim();
  if (!apiKey) { document.getElementById('api-warning').classList.add('show'); return; }
  const query = document.getElementById('query-input').value.trim();
  if (!query) return;

  isRunning = true;
  const btn = document.getElementById('run-btn');
  btn.disabled = true; btn.textContent = '⏳ RUNNING...';

  document.getElementById('trace-card').style.display = 'block';
  document.getElementById('response-card').style.display = 'none';
  document.getElementById('trace-list').innerHTML = '';
  document.getElementById('trace-status').textContent = 'executing...';

  const startTime = Date.now();
  const messages = [{ role: 'user', content: query }];
  let collectedData = {}, finalText = '';

  try {
    for (let loop = 0; loop < 8; loop++) {
      const tid = addTrace('⚡', `Claude reasoning (turn ${loop + 1})`, null, 'active');
      const res = await fetch('https://api.anthropic.com/v1/messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-api-key': apiKey, 'anthropic-version': '2023-06-01', 'anthropic-dangerous-direct-browser-calls': 'true' },
        body: JSON.stringify({ model: MODEL, max_tokens: 2048, system: SYSTEM_PROMPT, tools: TOOLS, messages })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error?.message || 'Claude API error');
      updateTrace(tid, '✓', 'done');
      messages.push({ role: 'assistant', content: data.content });

      if (data.stop_reason === 'end_turn') {
        finalText = data.content.filter(b => b.type === 'text').map(b => b.text).join('\n');
        break;
      }
      if (data.stop_reason !== 'tool_use') break;

      const toolBlocks = data.content.filter(b => b.type === 'tool_use');
      const toolResults = [];
      for (const tb of toolBlocks) {
        const ttid = addTrace('🔧', tb.name, tb.input, 'active');
        let result;
        try {
          result = await callTool(tb.name, tb.input);
          updateTrace(ttid, '✓', 'done');
          if (tb.name === 'find_client_by_name') collectedData.client = Array.isArray(result) ? result[0] : result;
          if (tb.name === 'get_financial_profile') collectedData.profile = Array.isArray(result) ? result[0] : result;
          if (tb.name === 'update_tax_records') collectedData.updated = true;
        } catch(e) {
          result = { error: e.message };
          updateTrace(ttid, '✗', 'error');
        }
        toolResults.push({ type: 'tool_result', tool_use_id: tb.id, content: JSON.stringify(result) });
      }
      messages.push({ role: 'user', content: toolResults });
    }

    const elapsed = ((Date.now() - startTime) / 1000).toFixed(1);
    document.getElementById('trace-status').textContent = `completed in ${elapsed}s`;
    renderResponse(finalText, collectedData, elapsed);
    addToHistory(query);
  } catch(e) {
    document.getElementById('trace-status').textContent = 'failed';
    document.getElementById('response-card').style.display = 'block';
    document.getElementById('response-body').innerHTML = `<div style="background:var(--accent-bg);border:1px solid var(--accent);border-radius:4px;padding:14px;font-family:'JetBrains Mono',monospace;font-size:0.75rem;color:var(--accent)">⚠ ${e.message}</div>`;
  }

  isRunning = false;
  btn.disabled = false;
  btn.textContent = '▶ RUN AGENT';
}

function formatINR(n) { if (!n && n !== 0) return '—'; return '₹' + Number(n).toLocaleString('en-IN'); }

function renderResponse(text, data, elapsed) {
  document.getElementById('response-card').style.display = 'block';
  document.getElementById('response-time').textContent = `${elapsed}s · ${new Date().toLocaleTimeString()}`;
  let html = '';
  if (data.profile) {
    const p = data.profile;
    const name = data.client ? `${data.client.firstname} ${data.client.lastname}` : `Client #${p.client_id}`;
    html += `<div class="data-grid">
      <div class="data-card" style="grid-column:1/-1"><div class="data-card-label">Client</div><div style="font-family:'Playfair Display',serif;font-size:1.15rem">${name}</div></div>
      <div class="data-card"><div class="data-card-label">Salary</div><div class="data-card-value">${formatINR(p.salary)}</div></div>
      <div class="data-card"><div class="data-card-label">LTCG</div><div class="data-card-value amber">${formatINR(p.ltcg)}</div></div>
      <div class="data-card"><div class="data-card-label">STCG</div><div class="data-card-value red">${formatINR(p.stcg)}</div></div>
      <div class="data-card"><div class="data-card-label">Annual Income</div><div class="data-card-value green">${formatINR((p.salary||0)+(p.ltcg||0)+(p.stcg||0))}</div></div>
    </div><hr class="divider">`;
  }
  html += `<div class="response-content">${formatMd(text)}</div>`;
  if (data.updated) html += `<div class="updated-badge">✓ Tax records successfully updated in AlloyDB</div>`;
  document.getElementById('response-body').innerHTML = html;
}

function formatMd(t) {
  return t
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.*?)\*/g, '<em>$1</em>')
    .replace(/`(.*?)`/g, '<code>$1</code>')
    .replace(/^### (.*)/gm, '<h4 style="font-family:\'Playfair Display\',serif;font-size:1rem;margin:14px 0 6px;color:var(--ink)">$1</h4>')
    .replace(/^## (.*)/gm, '<h3 style="font-family:\'Playfair Display\',serif;font-size:1.15rem;margin:18px 0 8px">$1</h3>')
    .replace(/^- (.*)/gm, '<div style="padding:3px 0 3px 14px;border-left:2px solid var(--border2);margin:4px 0;font-size:0.88rem">$1</div>')
    .replace(/\n/g, '<br>');
}

function addToHistory(query) {
  const list = document.getElementById('history-list');
  const empty = list.querySelector('.empty-state');
  if (empty) empty.remove();
  const el = document.createElement('div');
  el.className = 'history-item';
  el.innerHTML = `<div class="history-q">${query.slice(0,55)}${query.length>55?'…':''}</div><div class="history-ts">${new Date().toLocaleTimeString()}</div>`;
  el.onclick = () => setQuery(query);
  list.prepend(el);
}
</script>
</body>
</html>
